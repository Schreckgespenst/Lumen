# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored — never commit it.

# Which LLM backend to use: "groq" (cloud) or "ollama" (local)
LUMEN_BACKEND=groq

# Required when LUMEN_BACKEND=groq. Get one at https://console.groq.com/keys
GROQ_API_KEY=gsk_replace_me

# Optional — overrides the default model for the chosen backend.
#   groq   default: llama-3.1-8b-instant
#   ollama default: gemma4
# LUMEN_MODEL=llama-3.1-8b-instant

# Optional — only needed if Ollama runs somewhere other than localhost.
# OLLAMA_HOST=http://localhost:11434
